# Copy this file to .env and replace the placeholders.
# Required: PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Required: secret used to sign and verify NextAuth sessions.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Set both URLs to the address where you run the app.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: needed only for sending password-reset emails.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="mailer@example.com"
# SMTP_PASSWORD="replace-with-smtp-password"
# CONTACT_EMAIL="inbox@example.com" # Optional; defaults to SMTP_USER
